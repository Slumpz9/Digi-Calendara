<section class="section password">
  <div class="page-width page-width--narrow">
    <div class="password__device">{% render 'calendar-device' %}</div>
    <div class="section-heading">
      <p class="eyebrow">{{ shop.name }}</p>
      <h1 class="h1">{{ section.settings.heading | default: shop.name | escape }}</h1>
      {%- if shop.password_message != blank -%}
        <div class="section-heading__text rte">{{ shop.password_message }}</div>
      {%- endif -%}
    </div>

    <details class="password__login">
      <summary class="link">{{ 'password.enter_using_password' | t }}</summary>
      {%- form 'storefront_password', class: 'newsletter-form' -%}
        {%- if form.errors -%}
          <div class="form-message form-message--error" role="alert">{{ form.errors | default_errors }}</div>
        {%- endif -%}
        <div class="newsletter-form__row">
          <label class="visually-hidden" for="Password">{{ 'password.password_label' | t }}</label>
          <input class="field" id="Password" type="password" name="password" autocomplete="current-password" placeholder="{{ 'password.password_label' | t }}" required>
          <button class="button button--primary" type="submit">{{ 'password.enter' | t }}</button>
        </div>
      {%- endform -%}
    </details>
  </div>
</section>

{% schema %}
{
  "name": "Password page",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Opening soon"
    }
  ]
}
{% endschema %}
