<section class="section">
  <div class="page-width">
    <header class="page-header">
      <h1 class="h1">{{ 'collections.all_title' | t }}</h1>
    </header>

    <div class="product-grid">
      {%- for collection in collections -%}
        <article class="card">
          <a class="card__media" href="{{ collection.url }}" tabindex="-1" aria-hidden="true">
            {%- if collection.featured_image -%}
              {{
                collection.featured_image
                | image_url: width: 900
                | image_tag: loading: 'lazy', widths: '300, 450, 600, 900', sizes: '(min-width: 990px) 30vw, (min-width: 600px) 45vw, 90vw'
              }}
            {%- else -%}
              {% render 'calendar-device', compact: true %}
            {%- endif -%}
          </a>
          <div class="card__body">
            <h2 class="card__title"><a href="{{ collection.url }}">{{ collection.title | escape }}</a></h2>
            <p>{{ 'collections.count' | t: count: collection.products_count }}</p>
          </div>
        </article>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Collections list"
}
{% endschema %}
