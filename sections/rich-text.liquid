{%- assign s = section.settings -%}
<section class="section section--{{ s.background }}">
  <div class="page-width page-width--narrow">
    {% render 'section-heading', eyebrow: s.eyebrow, heading: s.heading, text: s.text %}
    {%- if s.button_label != blank -%}
      <div class="section__footer">
        <a class="button button--primary" href="{{ s.button_link | default: routes.all_products_collection_url }}">
          {{- s.button_label | escape -}}
        </a>
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Rich text",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Talk about your brand" },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Share the story behind your keepsakes and why you started the store.</p>"
    },
    { "type": "text", "id": "button_label", "label": "Button label" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    {
      "type": "select",
      "id": "background",
      "label": "Background",
      "options": [
        { "value": "default", "label": "Default" },
        { "value": "muted", "label": "Muted" },
        { "value": "dark", "label": "Dark" }
      ],
      "default": "default"
    }
  ],
  "presets": [{ "name": "Rich text" }]
}
{% endschema %}
