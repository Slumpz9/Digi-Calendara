<article class="section">
  <div class="page-width page-width--narrow">
    <header class="page-header">
      <p class="eyebrow">{{ article.published_at | time_tag: format: 'date' }}</p>
      <h1 class="h1">{{ article.title | escape }}</h1>
      {%- if section.settings.show_author -%}
        <p class="page-header__text">{{ 'blogs.by_author' | t: author: article.author }}</p>
      {%- endif -%}
    </header>

    {%- if article.image -%}
      <div class="article__image">
        {{
          article.image
          | image_url: width: 1600
          | image_tag: loading: 'eager', widths: '500, 800, 1200, 1600', sizes: '(min-width: 800px) 760px, 100vw'
        }}
      </div>
    {%- endif -%}

    <div class="rte">{{ article.content }}</div>

    <p class="article__back">
      <a class="link" href="{{ blog.url }}">&larr; {{ 'blogs.back' | t: title: blog.title }}</a>
    </p>
  </div>
</article>

<script type="application/ld+json">
  {{ article | structured_data }}
</script>

{% schema %}
{
  "name": "Blog post",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_author",
      "label": "Show author",
      "default": false
    }
  ]
}
{% endschema %}
