{%- assign s = section.settings -%}
<section class="section section--{{ s.background }}">
  <div class="page-width">
    {% render 'section-heading', eyebrow: s.eyebrow, heading: s.heading, text: s.text %}

    <ul role="list" class="features">
      {%- for block in section.blocks -%}
        <li class="feature" {{ block.shopify_attributes }}>
          <span class="feature__icon">{% render 'icon', name: block.settings.icon %}</span>
          {%- if block.settings.heading != blank -%}
            <h3 class="h4">{{ block.settings.heading | escape }}</h3>
          {%- endif -%}
          {%- if block.settings.text != blank -%}
            <div class="rte">{{ block.settings.text }}</div>
          {%- endif -%}
        </li>
      {%- endfor -%}
    </ul>
  </div>
</section>

{% schema %}
{
  "name": "Features",
  "max_blocks": 9,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "What it does" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "A small screen with a big memory inside" },
    { "type": "richtext", "id": "text", "label": "Text" },
    {
      "type": "select",
      "id": "background",
      "label": "Background",
      "options": [
        { "value": "default", "label": "Default" },
        { "value": "muted", "label": "Muted" },
        { "value": "dark", "label": "Dark" }
      ],
      "default": "default"
    }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Feature",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "play", "label": "Play" },
            { "value": "heart", "label": "Heart" },
            { "value": "gift", "label": "Gift" },
            { "value": "sparkle", "label": "Sparkle" },
            { "value": "photo", "label": "Photo" },
            { "value": "star", "label": "Star" },
            { "value": "touch", "label": "Touch" },
            { "value": "clock", "label": "Clock" },
            { "value": "home", "label": "Home" },
            { "value": "shield", "label": "Shield" },
            { "value": "check", "label": "Check" }
          ],
          "default": "sparkle"
        },
        { "type": "text", "id": "heading", "label": "Heading", "default": "Feature name" },
        {
          "type": "richtext",
          "id": "text",
          "label": "Text",
          "default": "<p>Describe what makes this feature special.</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Features",
      "blocks": [{ "type": "feature" }, { "type": "feature" }, { "type": "feature" }]
    }
  ]
}
{% endschema %}
