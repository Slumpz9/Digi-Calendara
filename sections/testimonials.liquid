{%- assign s = section.settings -%}
<section class="section section--{{ s.background }}">
  <div class="page-width">
    {% render 'section-heading', eyebrow: s.eyebrow, heading: s.heading %}

    <div class="quotes">
      {%- for block in section.blocks -%}
        <figure class="quote" {{ block.shopify_attributes }}>
          <blockquote class="rte">{{ block.settings.quote }}</blockquote>
          {%- if block.settings.author != blank -%}
            <figcaption>
              <strong>{{ block.settings.author | escape }}</strong>
              {%- if block.settings.detail != blank -%}<span>{{ block.settings.detail | escape }}</span>{%- endif -%}
            </figcaption>
          {%- endif -%}
        </figure>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Customer quotes",
  "max_blocks": 6,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "From real homes" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "What customers say" },
    {
      "type": "select",
      "id": "background",
      "label": "Background",
      "options": [
        { "value": "default", "label": "Default" },
        { "value": "muted", "label": "Muted" },
        { "value": "dark", "label": "Dark" }
      ],
      "default": "muted"
    }
  ],
  "blocks": [
    {
      "type": "quote",
      "name": "Quote",
      "settings": [
        {
          "type": "richtext",
          "id": "quote",
          "label": "Quote",
          "default": "<p>Paste a real customer review here once you have one.</p>"
        },
        { "type": "text", "id": "author", "label": "Customer name", "default": "Customer name" },
        { "type": "text", "id": "detail", "label": "Detail", "default": "Verified buyer" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Customer quotes",
      "blocks": [{ "type": "quote" }, { "type": "quote" }, { "type": "quote" }]
    }
  ]
}
{% endschema %}
