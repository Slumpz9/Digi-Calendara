{%- liquid
  assign current = product.selected_or_first_available_variant
  assign form_id = 'ProductForm-' | append: section.id
  assign active_media = current.featured_media | default: product.featured_media
-%}
<section class="section product" data-product data-section-id="{{ section.id }}" data-url="{{ product.url }}">
  <div class="page-width product__grid">
    <div class="product__media" aria-label="{{ 'products.gallery' | t }}">
      {%- if product.media.size > 0 -%}
        <ul role="list" class="product__slides">
          {%- for media in product.media -%}
            <li
              class="product__slide{% if media.id == active_media.id %} is-active{% endif %}"
              data-media-id="{{ media.id }}"
            >
              {%- case media.media_type -%}
                {%- when 'image' -%}
                  {%- if media.id == active_media.id -%}
                    {{
                      media
                      | image_url: width: 1600
                      | image_tag: loading: 'eager', fetchpriority: 'high', widths: '500, 800, 1100, 1600', sizes: '(min-width: 990px) 55vw, 100vw'
                    }}
                  {%- else -%}
                    {{
                      media
                      | image_url: width: 1600
                      | image_tag: loading: 'lazy', widths: '500, 800, 1100, 1600', sizes: '(min-width: 990px) 55vw, 100vw'
                    }}
                  {%- endif -%}
                {%- when 'video' -%}
                  {{ media | video_tag: controls: true, preload: 'metadata' }}
                {%- when 'external_video' -%}
                  {{ media | external_video_tag }}
                {%- when 'model' -%}
                  {{ media | model_viewer_tag }}
              {%- endcase -%}
            </li>
          {%- endfor -%}
        </ul>

        {%- if product.media.size > 1 -%}
          <ul role="list" class="product__thumbs">
            {%- for media in product.media -%}
              <li>
                <button
                  type="button"
                  class="product__thumb{% if media.id == active_media.id %} is-active{% endif %}"
                  data-thumb="{{ media.id }}"
                  aria-label="{{ 'products.media_thumbnail' | t: index: forloop.index }}"
                >
                  {{ media.preview_image | image_url: width: 200 | image_tag: loading: 'lazy', alt: '' }}
                </button>
              </li>
            {%- endfor -%}
          </ul>
        {%- endif -%}
      {%- else -%}
        <div class="product__placeholder">{% render 'orb' %}</div>
      {%- endif -%}
    </div>

    <div class="product__info">
      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when '@app' -%}
            {% render block %}

          {%- when 'vendor' -%}
            <p class="eyebrow" {{ block.shopify_attributes }}>{{ product.vendor | escape }}</p>

          {%- when 'title' -%}
            <h1 class="h2 product__title" {{ block.shopify_attributes }}>{{ product.title | escape }}</h1>

          {%- when 'price' -%}
            <div class="product__price" data-price {{ block.shopify_attributes }}>
              {% render 'price', product: product, variant: current %}
            </div>

          {%- when 'text' -%}
            {%- if block.settings.text != blank -%}
              <div class="product__text rte" {{ block.shopify_attributes }}>{{ block.settings.text }}</div>
            {%- endif -%}

          {%- when 'variant_picker' -%}
            {%- unless product.has_only_default_variant -%}
              <div class="variants" data-variant-picker {{ block.shopify_attributes }}>
                {%- for option in product.options_with_values -%}
                  <fieldset class="variants__group">
                    <legend>{{ option.name | escape }}</legend>
                    <div class="variants__options">
                      {%- for value in option.values -%}
                        {%- assign input_id = section.id | append: '-' | append: option.position | append: '-' | append: forloop.index -%}
                        <input
                          class="visually-hidden"
                          type="radio"
                          id="{{ input_id }}"
                          name="option-{{ option.position }}-{{ section.id }}"
                          value="{{ value | escape }}"
                          data-option-position="{{ option.position }}"
                          {% if option.selected_value == value %}checked{% endif %}
                        >
                        <label class="pill" for="{{ input_id }}">{{ value | escape }}</label>
                      {%- endfor -%}
                    </div>
                  </fieldset>
                {%- endfor -%}
                <script type="application/json" data-variants>
                  {{ product.variants | json }}
                </script>
              </div>
            {%- endunless -%}

          {%- when 'quantity' -%}
            <div class="product__quantity" {{ block.shopify_attributes }}>
              <label for="Quantity-{{ section.id }}">{{ 'products.quantity' | t }}</label>
              <div class="quantity" data-quantity>
                <button type="button" data-quantity-step="-1" aria-label="{{ 'products.decrease' | t }}">&minus;</button>
                <input
                  id="Quantity-{{ section.id }}"
                  type="number"
                  name="quantity"
                  value="1"
                  min="1"
                  inputmode="numeric"
                  form="{{ form_id }}"
                >
                <button type="button" data-quantity-step="1" aria-label="{{ 'products.increase' | t }}">+</button>
              </div>
            </div>

          {%- when 'buy_buttons' -%}
            <div class="product__buy" {{ block.shopify_attributes }}>
              {%- form 'product', product, id: form_id, class: 'product-form', data-product-form: '' -%}
                <input type="hidden" name="id" value="{{ current.id }}" data-variant-id>
                <noscript>
                  <select name="id" class="field" aria-label="{{ product.title | escape }}">
                    {%- for variant in product.variants -%}
                      <option
                        value="{{ variant.id }}"
                        {% if variant == current %}selected{% endif %}
                        {% unless variant.available %}disabled{% endunless %}
                      >
                        {{ variant.title | escape }} - {{ variant.price | money }}
                      </option>
                    {%- endfor -%}
                  </select>
                </noscript>
                <p class="form-message form-message--error" data-form-error role="alert" hidden></p>
                <button
                  type="submit"
                  name="add"
                  class="button button--primary button--full"
                  data-add
                  data-unavailable="{{ 'products.unavailable' | t }}"
                  {% unless current.available %}disabled{% endunless %}
                >
                  {%- if current.available -%}
                    {{ 'products.add_to_cart' | t }}
                  {%- else -%}
                    {{ 'products.sold_out' | t }}
                  {%- endif -%}
                </button>
                {%- if block.settings.show_dynamic_checkout -%}
                  {{ form | payment_button }}
                {%- endif -%}
              {%- endform -%}
            </div>

          {%- when 'perks' -%}
            {%- assign perks = block.settings.items | newline_to_br | split: '<br />' -%}
            <ul role="list" class="checklist product__perks" {{ block.shopify_attributes }}>
              {%- for perk in perks -%}
                {%- assign line = perk | strip -%}
                {%- if line != blank -%}
                  <li>{% render 'icon', name: 'check' %}<span>{{ line | escape }}</span></li>
                {%- endif -%}
              {%- endfor -%}
            </ul>

          {%- when 'description' -%}
            {%- if product.description != blank -%}
              <div class="product__description rte" {{ block.shopify_attributes }}>{{ product.description }}</div>
            {%- endif -%}

          {%- when 'collapsible' -%}
            {%- if block.settings.content != blank or block.settings.page != blank -%}
              <details class="accordion__item" {{ block.shopify_attributes }}>
                <summary>
                  <span>{{ block.settings.heading | default: block.settings.page.title | escape }}</span>
                  {% render 'icon', name: 'chevron' %}
                </summary>
                <div class="accordion__content rte">
                  {{ block.settings.content }}
                  {{ block.settings.page.content }}
                </div>
              </details>
            {%- endif -%}
        {%- endcase -%}
      {%- endfor -%}
    </div>
  </div>
</section>

<script type="application/ld+json">
  {{ product | structured_data }}
</script>

{% schema %}
{
  "name": "Product information",
  "blocks": [
    { "type": "@app" },
    { "type": "vendor", "name": "Vendor", "limit": 1 },
    { "type": "title", "name": "Title", "limit": 1 },
    { "type": "price", "name": "Price", "limit": 1 },
    {
      "type": "text",
      "name": "Text",
      "settings": [
        {
          "type": "richtext",
          "id": "text",
          "label": "Text",
          "default": "<p>A short line that sums up this product.</p>"
        }
      ]
    },
    { "type": "variant_picker", "name": "Variant picker", "limit": 1 },
    { "type": "quantity", "name": "Quantity", "limit": 1 },
    {
      "type": "buy_buttons",
      "name": "Buy buttons",
      "limit": 1,
      "settings": [
        {
          "type": "checkbox",
          "id": "show_dynamic_checkout",
          "label": "Show dynamic checkout button",
          "default": true
        }
      ]
    },
    {
      "type": "perks",
      "name": "Checklist",
      "settings": [
        {
          "type": "textarea",
          "id": "items",
          "label": "Items",
          "info": "One per line",
          "default": "Plays your own video\n2.8-inch colour screen\n4GB built-in memory"
        }
      ]
    },
    { "type": "description", "name": "Description", "limit": 1 },
    {
      "type": "collapsible",
      "name": "Collapsible row",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Details" },
        { "type": "richtext", "id": "content", "label": "Content" },
        { "type": "page", "id": "page", "label": "Content from page" }
      ]
    }
  ]
}
{% endschema %}
