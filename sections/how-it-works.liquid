{%- assign s = section.settings -%}
<section class="section section--{{ s.background }}" id="how-it-works">
  <div class="page-width">
    {% render 'section-heading', eyebrow: s.eyebrow, heading: s.heading, text: s.text %}

    <ol role="list" class="steps">
      {%- for block in section.blocks -%}
        <li class="step" {{ block.shopify_attributes }}>
          <span class="step__number" aria-hidden="true">{{ forloop.index }}</span>
          {%- if block.settings.image != blank -%}
            {{
              block.settings.image
              | image_url: width: 800
              | image_tag: loading: 'lazy', widths: '300, 500, 800', sizes: '(min-width: 750px) 30vw, 90vw', class: 'step__image'
            }}
          {%- endif -%}
          {%- if block.settings.heading != blank -%}
            <h3 class="h4">{{ block.settings.heading | escape }}</h3>
          {%- endif -%}
          {%- if block.settings.text != blank -%}
            <div class="rte">{{ block.settings.text }}</div>
          {%- endif -%}
        </li>
      {%- endfor -%}
    </ol>
  </div>
</section>

{% schema %}
{
  "name": "How it works",
  "max_blocks": 4,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "How it works" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Three steps to a gift they will keep" },
    { "type": "richtext", "id": "text", "label": "Text" },
    {
      "type": "select",
      "id": "background",
      "label": "Background",
      "options": [
        { "value": "default", "label": "Default" },
        { "value": "muted", "label": "Muted" },
        { "value": "dark", "label": "Dark" }
      ],
      "default": "dark"
    }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Step",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "heading", "label": "Heading", "default": "Step name" },
        {
          "type": "richtext",
          "id": "text",
          "label": "Text",
          "default": "<p>Explain this step in a sentence or two.</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "How it works",
      "blocks": [{ "type": "step" }, { "type": "step" }, { "type": "step" }]
    }
  ]
}
{% endschema %}
