{%- assign form_id = 'Contact-' | append: section.id -%}
<section class="section section--muted">
  <div class="page-width page-width--narrow">
    {% render 'section-heading', heading: section.settings.heading, text: section.settings.text %}

    {%- form 'contact', id: form_id, class: 'contact-form' -%}
      {%- if form.posted_successfully? -%}
        <p class="form-message" tabindex="-1" autofocus>{{ 'contact.success' | t }}</p>
      {%- elsif form.errors -%}
        <div class="form-message form-message--error" role="alert">{{ form.errors | default_errors }}</div>
      {%- endif -%}

      <div class="contact-form__row">
        <div>
          <label for="{{ form_id }}-name">{{ 'contact.name' | t }}</label>
          <input class="field" id="{{ form_id }}-name" type="text" name="contact[name]" autocomplete="name" value="{{ form.name | default: customer.name }}">
        </div>
        <div>
          <label for="{{ form_id }}-email">{{ 'contact.email' | t }}</label>
          <input class="field" id="{{ form_id }}-email" type="email" name="contact[email]" autocomplete="email" autocapitalize="off" value="{{ form.email | default: customer.email }}" required>
        </div>
      </div>
      <div>
        <label for="{{ form_id }}-phone">{{ 'contact.phone' | t }}</label>
        <input class="field" id="{{ form_id }}-phone" type="tel" name="contact[phone]" autocomplete="tel" value="{{ form.phone | default: customer.phone }}">
      </div>
      <div>
        <label for="{{ form_id }}-body">{{ 'contact.message' | t }}</label>
        <textarea class="field" id="{{ form_id }}-body" name="contact[body]" rows="6" required>{{ form.body }}</textarea>
      </div>
      <button class="button button--primary" type="submit">{{ 'contact.send' | t }}</button>
    {%- endform -%}
  </div>
</section>

{% schema %}
{
  "name": "Contact form",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Send us a message" },
    { "type": "richtext", "id": "text", "label": "Text" }
  ],
  "presets": [{ "name": "Contact form" }]
}
{% endschema %}
