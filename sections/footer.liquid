<footer class="footer section--dark">
  <div class="page-width">
    {%- if section.blocks.size > 0 -%}
      <div class="footer__grid">
        {%- for block in section.blocks -%}
          <div class="footer__block footer__block--{{ block.type }}" {{ block.shopify_attributes }}>
            {%- case block.type -%}
              {%- when 'text' -%}
                <p class="footer__brand">
                  {% render 'icon', name: 'sparkle' %}
                  <span>{{ block.settings.heading | default: shop.name | escape }}</span>
                </p>
                <div class="rte">{{ block.settings.text }}</div>
              {%- when 'menu' -%}
                {%- if block.settings.heading != blank -%}
                  <h2 class="footer__heading">{{ block.settings.heading | escape }}</h2>
                {%- endif -%}
                <ul role="list" class="footer__links">
                  {%- for link in block.settings.menu.links -%}
                    <li><a href="{{ link.url }}">{{ link.title | escape }}</a></li>
                  {%- endfor -%}
                </ul>
              {%- when 'newsletter' -%}
                {%- if block.settings.heading != blank -%}
                  <h2 class="footer__heading">{{ block.settings.heading | escape }}</h2>
                {%- endif -%}
                {%- if block.settings.text != blank -%}
                  <p>{{ block.settings.text | escape }}</p>
                {%- endif -%}
                {%- form 'customer', id: 'FooterNewsletter', class: 'newsletter-form' -%}
                  <input type="hidden" name="contact[tags]" value="newsletter">
                  {%- if form.posted_successfully? -%}
                    <p class="form-message" tabindex="-1" autofocus>{{ 'newsletter.success' | t }}</p>
                  {%- else -%}
                    {%- if form.errors -%}
                      <p class="form-message form-message--error">{{ form.errors.translated_fields.email | capitalize }} {{ form.errors.messages.email }}</p>
                    {%- endif -%}
                    <div class="newsletter-form__row">
                      <label class="visually-hidden" for="FooterNewsletterEmail">{{ 'newsletter.email_label' | t }}</label>
                      <input
                        class="field"
                        id="FooterNewsletterEmail"
                        type="email"
                        name="contact[email]"
                        value="{{ form.email }}"
                        placeholder="{{ 'newsletter.email_label' | t }}"
                        autocomplete="email"
                        autocapitalize="off"
                        required
                      >
                      <button class="button button--accent" type="submit">{{ 'newsletter.subscribe' | t }}</button>
                    </div>
                  {%- endif -%}
                {%- endform -%}
            {%- endcase -%}
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}

    <div class="footer__bottom">
      <p class="footer__copyright">
        &copy; {{ 'now' | date: '%Y' }} {{ shop.name | link_to: routes.root_url }}. {{ powered_by_link }}
      </p>

      {%- liquid
        assign socials = 'instagram,facebook,tiktok,youtube,pinterest' | split: ','
        assign has_social = false
        for social in socials
          assign key = 'social_' | append: social
          if settings[key] != blank
            assign has_social = true
          endif
        endfor
      -%}
      {%- if has_social -%}
        <ul role="list" class="footer__social" aria-label="{{ 'general.follow_us' | t }}">
          {%- for social in socials -%}
            {%- assign key = 'social_' | append: social -%}
            {%- if settings[key] != blank -%}
              <li><a href="{{ settings[key] }}" rel="noopener" target="_blank">{{ social | capitalize }}</a></li>
            {%- endif -%}
          {%- endfor -%}
        </ul>
      {%- endif -%}

      {%- if section.settings.show_payment_icons and shop.enabled_payment_types.size > 0 -%}
        <ul role="list" class="footer__payments" aria-label="{{ 'general.payment_methods' | t }}">
          {%- for type in shop.enabled_payment_types -%}
            <li>{{ type | payment_type_svg_tag: class: 'payment-icon' }}</li>
          {%- endfor -%}
        </ul>
      {%- endif -%}
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "max_blocks": 4,
  "settings": [
    {
      "type": "checkbox",
      "id": "show_payment_icons",
      "label": "Show payment icons",
      "default": true
    }
  ],
  "blocks": [
    {
      "type": "text",
      "name": "Brand text",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "info": "Leave empty to use the store name"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Text",
          "default": "<p>Glass keepsake orbs that play the memories you choose.</p>"
        }
      ]
    },
    {
      "type": "menu",
      "name": "Menu",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Help"
        },
        {
          "type": "link_list",
          "id": "menu",
          "label": "Menu",
          "default": "footer"
        }
      ]
    },
    {
      "type": "newsletter",
      "name": "Email signup",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Stay in the loop"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "New features, restocks and the occasional offer."
        }
      ]
    }
  ]
}
{% endschema %}
