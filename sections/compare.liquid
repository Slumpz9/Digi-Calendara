{%- assign s = section.settings -%}
<section class="section section--{{ s.background }}">
  <div class="page-width">
    {% render 'section-heading', eyebrow: s.eyebrow, heading: s.heading, text: s.text %}

    <div class="compare">
      {%- for block in section.blocks -%}
        {%- liquid
          assign b = block.settings
          assign linked = b.product
          assign specs = b.specs | newline_to_br | split: '<br />'
        -%}
        <article class="compare__card{% if b.highlight %} compare__card--highlight{% endif %}" {{ block.shopify_attributes }}>
          {%- if b.highlight and b.badge != blank -%}
            <span class="badge compare__badge">{{ b.badge | escape }}</span>
          {%- endif -%}
          <p class="compare__size">{{ b.size | escape }}</p>
          <h3 class="h4">{{ b.heading | default: linked.title | escape }}</h3>
          {%- if b.subheading != blank -%}<p class="compare__sub">{{ b.subheading | escape }}</p>{%- endif -%}

          <ul role="list" class="checklist">
            {%- for spec in specs -%}
              {%- assign line = spec | strip -%}
              {%- if line != blank -%}
                <li>{% render 'icon', name: 'check' %}<span>{{ line | escape }}</span></li>
              {%- endif -%}
            {%- endfor -%}
          </ul>

          <div class="compare__footer">
            {%- if linked != blank -%}
              {% render 'price', product: linked, show_from: true %}
              <a class="button {% if b.highlight %}button--primary{% else %}button--outline{% endif %} button--full" href="{{ linked.url }}">
                {{- b.button_label | escape -}}
              </a>
            {%- else -%}
              <a class="button {% if b.highlight %}button--primary{% else %}button--outline{% endif %} button--full" href="{{ routes.all_products_collection_url }}">
                {{- b.button_label | escape -}}
              </a>
            {%- endif -%}
          </div>
        </article>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Size comparison",
  "max_blocks": 4,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Compare sizes" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Which one fits your home?" },
    { "type": "richtext", "id": "text", "label": "Text" },
    {
      "type": "select",
      "id": "background",
      "label": "Background",
      "options": [
        { "value": "default", "label": "Default" },
        { "value": "muted", "label": "Muted" },
        { "value": "dark", "label": "Dark" }
      ],
      "default": "default"
    }
  ],
  "blocks": [
    {
      "type": "model",
      "name": "Model",
      "settings": [
        { "type": "product", "id": "product", "label": "Product", "info": "Adds the price and links the button" },
        { "type": "text", "id": "size", "label": "Size", "default": "15\"" },
        { "type": "text", "id": "heading", "label": "Name", "default": "Model name" },
        { "type": "text", "id": "subheading", "label": "Best for", "default": "Best for the kitchen wall" },
        {
          "type": "textarea",
          "id": "specs",
          "label": "Specs",
          "info": "One per line",
          "default": "Full HD touchscreen\nWall mount and stand included\nWi-Fi calendar sync"
        },
        { "type": "text", "id": "button_label", "label": "Button label", "default": "Shop this size" },
        { "type": "checkbox", "id": "highlight", "label": "Highlight this model", "default": false },
        { "type": "text", "id": "badge", "label": "Highlight badge", "default": "Most popular" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Size comparison",
      "blocks": [{ "type": "model" }, { "type": "model" }, { "type": "model" }]
    }
  ]
}
{% endschema %}
