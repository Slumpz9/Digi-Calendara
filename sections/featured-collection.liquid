{%- liquid
  assign s = section.settings
  assign featured = s.collection
-%}
<section class="section section--{{ s.background }}">
  <div class="page-width">
    {% render 'section-heading', eyebrow: s.eyebrow, heading: s.heading, text: s.text %}

    <div class="product-grid">
      {%- if featured != blank and featured.products.size > 0 -%}
        {%- for product in featured.products limit: s.limit -%}
          {% render 'product-card', product: product %}
        {%- endfor -%}
      {%- else -%}
        {%- for i in (1..3) -%}
          {% render 'product-card', placeholder: true %}
        {%- endfor -%}
      {%- endif -%}
    </div>

    {%- if s.button_label != blank -%}
      <div class="section__footer">
        <a class="button button--outline" href="{{ featured.url | default: routes.all_products_collection_url }}">
          {{- s.button_label | escape -}}
        </a>
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Featured collection",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "The collection" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Choose your orb" },
    { "type": "richtext", "id": "text", "label": "Text" },
    { "type": "collection", "id": "collection", "label": "Collection" },
    {
      "type": "range",
      "id": "limit",
      "label": "Products to show",
      "min": 2,
      "max": 9,
      "step": 1,
      "default": 3
    },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "View all" },
    {
      "type": "select",
      "id": "background",
      "label": "Background",
      "options": [
        { "value": "default", "label": "Default" },
        { "value": "muted", "label": "Muted" },
        { "value": "dark", "label": "Dark" }
      ],
      "default": "muted"
    }
  ],
  "presets": [{ "name": "Featured collection" }]
}
{% endschema %}
