{%- paginate collection.products by section.settings.per_page -%}
  <section class="section">
    <div class="page-width">
      <header class="page-header">
        <h1 class="h1">{{ collection.title | escape }}</h1>
        {%- if collection.description != blank -%}
          <div class="page-header__text rte">{{ collection.description }}</div>
        {%- endif -%}
      </header>

      <div class="toolbar">
        <p class="toolbar__count">{{ 'collections.count' | t: count: collection.products_count }}</p>
        {%- if section.settings.show_sort -%}
          {%- assign sort_by = collection.sort_by | default: collection.default_sort_by -%}
          <div class="toolbar__sort">
            <label for="SortBy">{{ 'collections.sort_by' | t }}</label>
            <select id="SortBy" class="field field--select" data-sort>
              {%- for option in collection.sort_options -%}
                <option value="{{ option.value | escape }}"{% if option.value == sort_by %} selected{% endif %}>
                  {{- option.name | escape -}}
                </option>
              {%- endfor -%}
            </select>
          </div>
        {%- endif -%}
      </div>

      {%- if collection.products.size > 0 -%}
        <div class="product-grid">
          {%- for product in collection.products -%}
            {% render 'product-card', product: product %}
          {%- endfor -%}
        </div>
      {%- else -%}
        <p class="empty">{{ 'collections.empty' | t }}</p>
      {%- endif -%}

      {%- if paginate.pages > 1 -%}
        <nav class="pagination" aria-label="{{ 'general.pagination' | t }}">
          {{ paginate | default_pagination }}
        </nav>
      {%- endif -%}
    </div>
  </section>
{%- endpaginate -%}

{% schema %}
{
  "name": "Product grid",
  "settings": [
    {
      "type": "range",
      "id": "per_page",
      "label": "Products per page",
      "min": 6,
      "max": 24,
      "step": 3,
      "default": 12
    },
    {
      "type": "checkbox",
      "id": "show_sort",
      "label": "Show sorting",
      "default": true
    }
  ]
}
{% endschema %}
