{%- liquid
  assign s = section.settings
  assign form_id = 'Newsletter-' | append: section.id
-%}
<section class="section section--{{ s.background }}">
  <div class="page-width page-width--narrow newsletter">
    {% render 'section-heading', eyebrow: s.eyebrow, heading: s.heading, text: s.text %}

    {%- form 'customer', id: form_id, class: 'newsletter-form' -%}
      <input type="hidden" name="contact[tags]" value="newsletter">
      {%- if form.posted_successfully? -%}
        <p class="form-message" tabindex="-1" autofocus>{{ 'newsletter.success' | t }}</p>
      {%- else -%}
        {%- if form.errors -%}
          <p class="form-message form-message--error">{{ form.errors.translated_fields.email | capitalize }} {{ form.errors.messages.email }}</p>
        {%- endif -%}
        <div class="newsletter-form__row">
          <label class="visually-hidden" for="{{ form_id }}-email">{{ 'newsletter.email_label' | t }}</label>
          <input
            class="field"
            id="{{ form_id }}-email"
            type="email"
            name="contact[email]"
            value="{{ form.email }}"
            placeholder="{{ 'newsletter.email_label' | t }}"
            autocomplete="email"
            autocapitalize="off"
            required
          >
          <button class="button button--primary" type="submit">{{ 'newsletter.subscribe' | t }}</button>
        </div>
      {%- endif -%}
    {%- endform -%}
  </div>
</section>

{% schema %}
{
  "name": "Email signup",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Be first to hear about new keepsakes" },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Restocks, new features and the occasional offer. Unsubscribe any time.</p>"
    },
    {
      "type": "select",
      "id": "background",
      "label": "Background",
      "options": [
        { "value": "default", "label": "Default" },
        { "value": "muted", "label": "Muted" },
        { "value": "dark", "label": "Dark" }
      ],
      "default": "muted"
    }
  ],
  "presets": [{ "name": "Email signup" }]
}
{% endschema %}
