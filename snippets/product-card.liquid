{%- comment -%}
  Product card.
  Usage: {% render 'product-card', product: product %}
         {% render 'product-card', placeholder: true %}
{%- endcomment -%}
<article class="card">
  {%- if product != blank and placeholder != true -%}
    <a class="card__media" href="{{ product.url }}" tabindex="-1" aria-hidden="true">
      {%- if product.featured_media -%}
        {{
          product.featured_media
          | image_url: width: 900
          | image_tag: loading: 'lazy', widths: '300, 450, 600, 900', sizes: '(min-width: 990px) 30vw, (min-width: 600px) 45vw, 90vw'
        }}
      {%- else -%}
        {% render 'orb', compact: true %}
      {%- endif -%}
    </a>
    <div class="card__body">
      <h3 class="card__title"><a href="{{ product.url }}">{{ product.title | escape }}</a></h3>
      {% render 'price', product: product, show_from: true %}
      {%- unless product.available -%}
        <span class="badge badge--muted">{{ 'products.sold_out' | t }}</span>
      {%- endunless -%}
    </div>
  {%- else -%}
    <div class="card__media">{% render 'orb', compact: true %}</div>
    <div class="card__body">
      <h3 class="card__title">{{ 'onboarding.product_title' | t }}</h3>
      <div class="price"><span class="price__current">{{ 9900 | money }}</span></div>
    </div>
  {%- endif -%}
</article>
