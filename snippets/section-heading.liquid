{%- comment -%}
  Shared section intro.
  Usage: {% render 'section-heading', eyebrow: s.eyebrow, heading: s.heading, text: s.text %}
{%- endcomment -%}
{%- if eyebrow != blank or heading != blank or text != blank -%}
  <div class="section-heading{% if align == 'left' %} section-heading--left{% endif %}">
    {%- if eyebrow != blank -%}<p class="eyebrow">{{ eyebrow | escape }}</p>{%- endif -%}
    {%- if heading != blank -%}<h2 class="h2">{{ heading | escape }}</h2>{%- endif -%}
    {%- if text != blank -%}<div class="section-heading__text rte">{{ text }}</div>{%- endif -%}
  </div>
{%- endif -%}
