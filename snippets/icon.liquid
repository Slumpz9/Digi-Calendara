{%- comment -%}
  Renders a 24px stroke icon.
  Usage: {% render 'icon', name: 'cart' %}
{%- endcomment -%}
<svg class="icon icon-{{ name }}" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
  {%- case name -%}
    {%- when 'cart' -%}
      <path d="M5 8h14l-1.2 11H6.2L5 8z"/><path d="M9 8V6.5a3 3 0 0 1 6 0V8"/>
    {%- when 'menu' -%}
      <path d="M4 7h16M4 12h16M4 17h16"/>
    {%- when 'close' -%}
      <path d="M6 6l12 12M18 6L6 18"/>
    {%- when 'search' -%}
      <circle cx="11" cy="11" r="6.5"/><path d="M16 16l4.5 4.5"/>
    {%- when 'account' -%}
      <circle cx="12" cy="8.5" r="3.5"/><path d="M5 20c.8-3.6 3.6-5.5 7-5.5s6.2 1.9 7 5.5"/>
    {%- when 'check' -%}
      <path d="M5 12.5l4.5 4.5L19 7.5"/>
    {%- when 'chevron' -%}
      <path d="M6 9l6 6 6-6"/>
    {%- when 'calendar' -%}
      <rect x="3.5" y="5" width="17" height="15" rx="2.5"/><path d="M3.5 10h17M8 3v4M16 3v4"/>
    {%- when 'sync' -%}
      <path d="M4 12a8 8 0 0 1 13.7-5.6L20 8.5"/><path d="M20 4v4.5h-4.5"/><path d="M20 12a8 8 0 0 1-13.7 5.6L4 15.5"/><path d="M4 20v-4.5h4.5"/>
    {%- when 'palette' -%}
      <circle cx="7" cy="8" r="3"/><circle cx="17" cy="8" r="3"/><circle cx="12" cy="16.5" r="3"/>
    {%- when 'list' -%}
      <path d="M4 7l1.5 1.5L8 6M4 13l1.5 1.5L8 12M4 19l1.5 1.5L8 18M11.5 7.5H20M11.5 13.5H20M11.5 19.5H20"/>
    {%- when 'meal' -%}
      <path d="M7 3v7a2 2 0 0 0 2 2v9M5 3v5M9 3v5"/><path d="M17 21v-7h-2.5V7.5C14.5 5 15.5 3.5 17 3v18z"/>
    {%- when 'photo' -%}
      <rect x="3.5" y="5" width="17" height="14" rx="2.5"/><circle cx="9" cy="10" r="1.7"/><path d="M4 17l5-4.5 3.5 3 3-2.5 4.5 4"/>
    {%- when 'star' -%}
      <path d="M12 3.5l2.6 5.4 5.9.8-4.3 4.1 1.1 5.9L12 16.9l-5.3 2.8 1.1-5.9-4.3-4.1 5.9-.8L12 3.5z"/>
    {%- when 'truck' -%}
      <path d="M2.5 6.5h11v10h-11zM13.5 10h4l3 3v3.5h-7"/><circle cx="7" cy="17.5" r="1.8"/><circle cx="17" cy="17.5" r="1.8"/>
    {%- when 'shield' -%}
      <path d="M12 3l7 2.5v5.5c0 4.5-2.8 8-7 10-4.2-2-7-5.5-7-10V5.5L12 3z"/><path d="M9 12l2.2 2.2L15 10.5"/>
    {%- when 'home' -%}
      <path d="M4 11l8-7 8 7v8.5a1 1 0 0 1-1 1h-4.5v-6h-5v6H5a1 1 0 0 1-1-1V11z"/>
    {%- when 'wifi' -%}
      <path d="M3 9.5a13 13 0 0 1 18 0M6 13a8.5 8.5 0 0 1 12 0M9 16.5a4.2 4.2 0 0 1 6 0"/><circle cx="12" cy="19.5" r=".8" fill="currentColor"/>
    {%- when 'clock' -%}
      <circle cx="12" cy="12" r="8.5"/><path d="M12 7.5V12l3 2"/>
    {%- when 'touch' -%}
      <path d="M9 11.5V5.5a1.5 1.5 0 0 1 3 0v5l4.7 1c1 .2 1.7 1.1 1.6 2.1l-.5 4.4a2 2 0 0 1-2 1.8h-4a2 2 0 0 1-1.7-.9L6.5 13.5c-.5-.8.5-1.8 1.3-1.2l1.2.9"/>
    {%- when 'play' -%}
      <circle cx="12" cy="12" r="8.5"/><path d="M10.2 8.6v6.8l5.6-3.4-5.6-3.4z"/>
    {%- when 'heart' -%}
      <path d="M12 19.5s-7-4.3-7-9.4a3.9 3.9 0 0 1 7-2.5 3.9 3.9 0 0 1 7 2.5c0 5.1-7 9.4-7 9.4z"/>
    {%- when 'gift' -%}
      <rect x="4.5" y="10" width="15" height="10" rx="1.5"/><path d="M3.5 7h17v3h-17zM12 7v13M12 7c-2 0-4-.6-4-2.2C8 3.6 9 3 9.8 3 11.4 3 12 5.4 12 7zM12 7c2 0 4-.6 4-2.2C16 3.6 15 3 14.2 3 12.6 3 12 5.4 12 7z"/>
    {%- when 'sparkle' -%}
      <path d="M11 4l1.8 4.9 4.9 1.8-4.9 1.8L11 17.4l-1.8-4.9-4.9-1.8 4.9-1.8L11 4z"/><path d="M18.5 16v4M16.5 18h4"/>
    {%- else -%}
      <circle cx="12" cy="12" r="8.5"/>
  {%- endcase -%}
</svg>
