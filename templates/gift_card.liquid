{% layout none %}
<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="robots" content="noindex">
    {%- assign formatted_initial_value = gift_card.initial_value | money_without_trailing_zeros: gift_card.currency -%}
    <title>{{ 'gift_cards.title' | t: value: formatted_initial_value, shop: shop.name }}</title>
    {{ content_for_header }}
    {% render 'theme-styles' %}
    {{ 'base.css' | asset_url | stylesheet_tag }}
  </head>
  <body class="template-gift-card">
    <main class="section">
      <div class="page-width page-width--narrow gift-card">
        <p class="eyebrow">{{ shop.name }}</p>
        <h1 class="h2">{{ 'gift_cards.title' | t: value: formatted_initial_value, shop: shop.name }}</h1>

        <div class="gift-card__panel">
          {%- if gift_card.expired -%}
            <p class="badge badge--muted">{{ 'gift_cards.expired' | t }}</p>
          {%- endif -%}
          <p class="gift-card__label">{{ 'gift_cards.balance' | t }}</p>
          <p class="h2">{{ gift_card.balance | money }}</p>
          <p class="gift-card__label">{{ 'gift_cards.code' | t }}</p>
          <p class="gift-card__code">{{ gift_card.code | format_code }}</p>
          {%- if gift_card.expires_on and gift_card.expired == false -%}
            {%- assign expiry = gift_card.expires_on | date: format: 'date' -%}
            <p>{{ 'gift_cards.expires_on' | t: date: expiry }}</p>
          {%- endif -%}
          {%- if gift_card.pass_url -%}
            <a href="{{ gift_card.pass_url }}">
              <img src="{{ 'gift-card/add-to-apple-wallet.svg' | shopify_asset_url }}" width="120" height="40" alt="Add to Apple Wallet" loading="lazy">
            </a>
          {%- endif -%}
        </div>

        <a class="button button--primary" href="{{ shop.url }}">{{ 'gift_cards.shop' | t }}</a>
      </div>
    </main>
  </body>
</html>
